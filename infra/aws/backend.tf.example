# =============================================================================
# backend.tf.example — Cấu hình S3 remote state backend
# =============================================================================
#
# Bước 1: Tạo S3 bucket + DynamoDB table cho state (chạy 1 lần, thủ công):
#
#   aws s3api create-bucket \
#     --bucket cmd-support-terraform-state \
#     --region ap-southeast-1 \
#     --create-bucket-configuration LocationConstraint=ap-southeast-1
#
#   aws s3api put-bucket-versioning \
#     --bucket cmd-support-terraform-state \
#     --versioning-configuration Status=Enabled
#
#   aws s3api put-bucket-encryption \
#     --bucket cmd-support-terraform-state \
#     --server-side-encryption-configuration \
#       '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"aws:kms"}}]}'
#
#   aws s3api put-public-access-block \
#     --bucket cmd-support-terraform-state \
#     --public-access-block-configuration \
#       BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
#
#   aws dynamodb create-table \
#     --table-name cmd-support-terraform-lock \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST \
#     --region ap-southeast-1
#
# Bước 2: Copy file này thành backend.tf và bỏ comment block dưới:

# terraform {
#   backend "s3" {
#     bucket         = "cmd-support-terraform-state"
#     key            = "cmd-support/pilot/terraform.tfstate"
#     region         = "ap-southeast-1"
#     encrypt        = true
#     dynamodb_table = "cmd-support-terraform-lock"
#   }
# }
