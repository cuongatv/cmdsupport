# ============================================================
# CMD Support — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- PostgreSQL ---
# Inside docker-compose use service name 'postgres'. For local dev outside
# docker (e.g. running the API directly on your machine), change to 'localhost'.
DATABASE_URL=postgresql+asyncpg://arkon:arkon_secret@postgres:5432/cmd_support

# --- Auth (JWT) ---
# Used to sign JWT tokens and encrypt stored API keys.
# Generate a strong random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-string

# --- Default Admin Account ---
# Created automatically on first startup if no admin exists.
# Change the password in the Admin Portal after first login.
DEFAULT_ADMIN_EMAIL=admin@cmdsupport.com
DEFAULT_ADMIN_PASSWORD=cmd@1234

# --- Storage backend ---
STORAGE_BACKEND=minio    # 'minio' (local) | 's3' (AWS)

# --- MinIO (S3-compatible file storage) ---
# Inside docker-compose use service name 'minio:9000'. For local dev outside
# docker change to 'localhost:9000'.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-minio-secret
# Default bucket for new deployments. Existing local pilots may use 'arkon-files'.
MINIO_BUCKET=cmd-support-files
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRY_HOURS=24
# Host:port baked into PRESIGNED URLs (the one the browser fetches). Must be
# reachable from the user's browser:
#   - local docker dev  → localhost:9000
#   - production domain → minio.example.com  (set MINIO_PUBLIC_SECURE=true)
# Leave empty to reuse MINIO_ENDPOINT (only works when API and browser share DNS).
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false

# --- S3 (when STORAGE_BACKEND=s3) ---
# S3_REGION=ap-southeast-1
# S3_BUCKET=cmd-support-files
# S3_ENDPOINT_URL=                 # leave empty for AWS
# S3_ACCESS_KEY_ID=                # leave empty to use IAM role
# S3_SECRET_ACCESS_KEY=
# S3_USE_SSL=true
# S3_ADDRESSING_STYLE=virtual
# S3_PRESIGN_EXPIRY_HOURS=24

# --- Redis (background worker queue) ---
# Inside docker-compose use service name 'redis'. For local dev outside docker
# change to 'localhost'.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
WORKER_MAX_JOBS=3
WORKER_JOB_TIMEOUT=600

# --- CORS ---
CORS_ORIGINS=*

# --- Frontend ---
# Leave EMPTY for the standard docker-compose deployment. The browser then
# uses relative URLs (/api/...) and Next.js rewrites (frontend/next.config.ts)
# proxy them to the api container server-side. Same-origin = no CORS issues
# and no Chrome/Edge "Private Network Access" prompt
# ("<site> wants to access other apps and services on this device").
#
# Only set this when running the Next dev server OUTSIDE docker against a
# separately-running API, e.g. NEXT_PUBLIC_API_URL=http://localhost:5055
NEXT_PUBLIC_API_URL=

# ============================================================
# AI provider settings (embedding, LLM, vision) are configured
# through the Admin Portal > Settings, NOT in this file.
#
# Supported providers:
#   Embedding : google | openai | voyage | ollama | cohere
#   LLM       : google | openai | anthropic | ollama
#   Vision    : google | openai
#
# The LLM is used for wiki compilation — choose a model with a
# large context window (e.g. gemini-2.5-pro, gpt-4o,
# claude-sonnet-4-5).
# ============================================================
