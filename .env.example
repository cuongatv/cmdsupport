# ============================================================
# CMD Support — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://arkon:arkon_secret@localhost:5432/cmd_support

# --- Auth (JWT) ---
# Used to sign JWT tokens and encrypt stored API keys.
# Generate a strong random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-string

# --- Default Admin Account ---
# Created automatically on first startup if no admin exists.
# Change the password in the Admin Portal after first login.
DEFAULT_ADMIN_EMAIL=admin@cmdsupport.com
DEFAULT_ADMIN_PASSWORD=cmd@1234

# --- Storage backend ---
STORAGE_BACKEND=minio    # 'minio' (local) | 's3' (AWS)

# --- MinIO (S3-compatible file storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-minio-secret
# Default bucket for new deployments. Existing local pilots may use 'arkon-files'.
MINIO_BUCKET=cmd-support-files
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRY_HOURS=24

# --- S3 (when STORAGE_BACKEND=s3) ---
# S3_REGION=ap-southeast-1
# S3_BUCKET=cmd-support-files
# S3_ENDPOINT_URL=                 # leave empty for AWS
# S3_ACCESS_KEY_ID=                # leave empty to use IAM role
# S3_SECRET_ACCESS_KEY=
# S3_USE_SSL=true
# S3_ADDRESSING_STYLE=virtual
# S3_PRESIGN_EXPIRY_HOURS=24

# --- Redis (background worker queue) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
WORKER_MAX_JOBS=3
WORKER_JOB_TIMEOUT=600

# --- CORS ---
CORS_ORIGINS=*

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:5055

# ============================================================
# AI provider settings (embedding, LLM, vision) are configured
# through the Admin Portal > Settings, NOT in this file.
#
# Supported providers:
#   Embedding : google | openai | voyage | ollama | cohere
#   LLM       : google | openai | anthropic | ollama
#   Vision    : google | openai
#
# The LLM is used for wiki compilation — choose a model with a
# large context window (e.g. gemini-2.5-pro, gpt-4o,
# claude-sonnet-4-5).
# ============================================================
