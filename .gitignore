.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local

# Docker volumes (root-level only — do NOT match app/data/ which holds seed JSON)
/pg_data/
/minio_data/
/data/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Testing
.pytest_cache/
htmlcov/
.coverage

# Node (frontend)
frontend/node_modules/
frontend/.next/
frontend/out/

# Alembic
alembic/__pycache__/

# UV
uv.lock

# Grapuco
.grapuco/

# Reference
stitch_enterprise_claude_control_center
PageIndex-main
obsidian-wiki-main
llm_wiki-main
.rtk/

# Terraform — binaries auto-downloaded by `terraform init`,
# state files contain secrets, never commit either.
# Keep .terraform.lock.hcl (lockfile) and *.tfvars.example.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
.terraformrc
terraform.rc

# Workflow / tooling artifacts (local, throwaway)
.sisyphus/
.playwright-mcp/
.claude/

# DB backups (sensitive + large)
backups/

# AI session dumps (root-level scratchpads)
session-*.md

# Stray root-level images (subdirs like docs/assets/, frontend/public/ unaffected)
/*.png

# Python tooling caches
.mypy_cache/
.ruff_cache/

# Playwright reports
frontend/test-results/
frontend/playwright-report/
.gstack/
